# Copy to .env and fill in (or enter these as stack env vars in Portainer).
# Never commit a filled-in copy. Keep the real values in a password manager.

# ---- host layout -----------------------------------------------------------
# Per-service config dirs are created under here (bind mounts). Back it up.
CONFIG_ROOT=/srv/media-stack/config
# The media pool. Mounted at /data in every container; keep downloads,
# movies and tv under it so imports are hard links, not copies.
MEDIA_ROOT=/mnt/storage
# Optional fast scratch (SSD) for in-progress downloads / transcodes.
#INCOMPLETE_ROOT=/mnt/ssd/qbit-incomplete
#TRANSCODE_ROOT=/mnt/ssd/transcodes

# uid/gid that owns CONFIG_ROOT and MEDIA_ROOT on the host (`id`).
PUID=1000
PGID=1000
TZ=America/Chicago

# ---- VPN (gluetun) ---------------------------------------------------------
# WireGuard private key from your VPN provider's manual-setup page.
VPN_SERVICE_PROVIDER=nordvpn
VPN_SERVER_COUNTRIES=United States
WIREGUARD_PRIVATE_KEY=

# ---- Unpackerr -> arr links ------------------------------------------------
# Leave blank on first deploy. Once Sonarr/Radarr are running, copy from
# Settings -> General -> API Key, fill these in, then restart unpackerr.
SONARR_API_KEY=
RADARR_API_KEY=

# ---- Jellystat (optional) --------------------------------------------------
# Any strong random strings: `openssl rand -hex 24`
JELLYSTAT_DB_PASSWORD=
JELLYSTAT_JWT_SECRET=

# ---- Cloudflare Tunnel (optional) -----------------------------------------
# Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> token.
TUNNEL_TOKEN=
